# バックエンド API サーバー設定 (Cloud Run / ローカル開発)
PORT=8080

# Google Cloud / Gemini Enterprise Agent Platform (旧 Vertex AI) / Firestore 設定
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Gemini が答えを考える量 (LOW / MEDIUM / HIGH)。既定は LOW。考える量を指定できないモデルでは空にする
# GEMINI_THINKING_LEVEL=LOW

# Gemini API キーを使用する場合 (Agent Platform の ADC を使わないローカル検証用)
# GEMINI_API_KEY=

# フロントエンド開発環境でモバイル実機・トンネル経由アクセスを許可するホスト (カンマ区切り、任意)
# VITE_ALLOWED_HOSTS=.trycloudflare.com

# API の呼び出し回数の上限（1分あたり）。接続元ごとと、サーバー全体の両方で数える（任意、既定値は下のとおり）
# RATE_LIMIT_GEMINI_PER_CLIENT=20
# RATE_LIMIT_GEMINI_GLOBAL=120
# RATE_LIMIT_TTS_PER_CLIENT=60
# RATE_LIMIT_TTS_GLOBAL=300
# RATE_LIMIT_RECORD_PER_CLIENT=20
# RATE_LIMIT_RECORD_GLOBAL=300
# Gemini を呼べる1日あたりの回数（日本時間で区切る）。超えたら、その日は Gemini を呼ばない（費用の非常停止）
# RATE_LIMIT_GEMINI_DAILY=2000
# 1つの接続元から同時に処理する、Gemini を呼ぶリクエストの数
# RATE_LIMIT_CONCURRENT_PER_CLIENT=2
# このサイトのほかに、API を呼んでよい画面の Origin（カンマ区切り、任意）
# ALLOWED_ORIGINS=https://example.web.app

# Model Armor で、学習者の発言を Gemini に送る前に調べる（任意）。設定しないときは、メールアドレスと電話番号だけをコードの規則で止める
# MODEL_ARMOR_LOCATION=us-central1
# MODEL_ARMOR_TEMPLATE_ID=studio-input-guard

# 記録の送り先（任意）。指示の文章は送らない。BigQuery には集計への協力に同意した挑戦だけを送る
# BIGQUERY_DATASET=studio_telemetry
# BIGQUERY_TABLE=prompt_events
# BIGQUERY_RUN_TABLE=run_events
# 0 にすると Cloud Firestore に送らない
# FIRESTORE_ENABLED=1

# 授業やワークショップなどで公開ホストするとき、起動時の利用上の注意と集計への同意ウィンドウを有効にする（任意）
# VITE_PUBLIC_NOTICE=1
# 案内ウィンドウ内に表示する運営・代表・問い合わせ先（任意、設定した項目だけ表示）
# VITE_OPERATOR_TEAM=
# VITE_OPERATOR_NAME=
# VITE_OPERATOR_URL=
# VITE_OPERATOR_EMAIL=
